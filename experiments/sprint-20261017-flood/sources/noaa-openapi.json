        "parameters": [
          {
            "name": "identifier",
            "description": "The gauge's unique identifier, LID or USGS ID. Example: ANAW1 or 13334300",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "Gauges"
        ]
      }
    },
    "/nwps/v1/gauges/{identifier}/stageflow": {
      "get": {
