{
  "swagger": "2.0",
  "info": {
    "title": "National Water Prediction Service API",
    "description": "API for the National Water Prediction Service's hydrologic products.",
    "version": "1.0.0",
    "contact": {
      "name": "National Water Center",
      "url": "https://water.noaa.gov/",
      "email": "nws.nwc.ops@noaa.gov"
    }
  },
