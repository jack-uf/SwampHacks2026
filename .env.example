PLANIT_DB=data/planit.sqlite
PLANIT_USER_AGENT=PlanITControl/0.1 (local research prototype; contact: your-email@example.com)
# Required for authenticated supervisor mutations. Set the same value in the dashboard settings.
PLANIT_ADMIN_TOKEN=change-this-local-token
# Optional webhook delivery: only used when explicitly enabled.
PLANIT_BRIEFING_WEBHOOK=
PLANIT_ENABLE_DELIVERY=false
# Real strike ingestion requires a configured shared secret; replay is separate.
PLANIT_LIGHTNING_TOKEN=

# Optional paid Jev text triage. Enable only after authorizing costs and privacy terms.
PLANIT_JEV_ENABLED=false
TYPESAFE_API_KEY=
PLANIT_JEV_MODEL=jev-1.13.0
